%=====================================================================
%  [4] TEMA, WARNA & FOOTER
%=====================================================================
\usetheme{Madrid}   % Tema dasar (alternatif: CambridgeUS, Dresden, dsb.)

%  ---- PALET WARNA --------------------------------------------------
%  fg = warna teks (foreground), bg = warna latar (background)
%  Gunakan dalam \textcolor{telu}{...} atau \setbeamercolor{...}
\definecolor{smuBlue}{RGB}{21, 28, 85}    % biru tua (blok contoh)
\definecolor{scisGold}{RGB}{198, 146, 0}  % emas  (aksen utama, bullet, tombol)
\definecolor{telu}{RGB}{148, 0, 0}        % merah Telkom University
\definecolor{merah}{RGB}{255, 0, 0}       % merah terang (judul frame)
\definecolor{abu}{RGB}{211, 211, 211}     % abu-abu terang (footer tanggal)
\definecolor{abu1}{RGB}{47, 79, 79}       % abu kebiruan (batang judul frame)
\definecolor{abu2}{RGB}{241, 241, 241}    % abu sangat terang (footer judul)

%  Struktur dasar (judul bagian, bullet, tautan, rumus)
\setbeamercolor*{structure}{bg=smuBlue, fg=smuBlue}
\setbeamercolor*{palette primary}{use=structure, fg=telu, bg=abu}
\setbeamercolor*{palette secondary}{use=structure, fg=white, bg=telu}
\setbeamercolor*{palette tertiary}{use=structure, fg=white, bg=smuBlue}

%  Batang judul setiap slide (frametitle)
\setbeamercolor{frametitle}{bg=abu1, fg=merah}
\setbeamercolor*{titlelike}{parent=palette primary}

%  ---- FOOTER (kaki slide: nama | judul | tanggal+nomor) -------------
%  PERBAIKAN: lebar total kini tepat 100% kertas
%  ( .25 + .47 + .28 = 1.00 ; pada versi lama 1.05 sehingga bergeser )
\setbeamercolor{author in head/foot}{fg=white, bg=scisGold}
\setbeamerfont{author in head/foot}{size=\tiny}

\setbeamercolor{nama_}{fg=white, bg=telu}      % kotak kiri  : nama
\setbeamercolor{judul_}{fg=telu, bg=abu2}      % kotak tengah: judul pendek
\setbeamercolor{tanggal_nomor}{fg=telu, bg=abu}% kotak kanan : tanggal + no.

\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.25\paperwidth,ht=2.25ex,dp=1ex,center]{nama_}%
      \usebeamerfont{author in head/foot}\insertshortauthor
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.47\paperwidth,ht=2.25ex,dp=1ex,center]{judul_}%
      \usebeamerfont{author in head/foot}\insertshorttitle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.28\paperwidth,ht=2.25ex,dp=1ex,center]{tanggal_nomor}%
      \usebeamerfont{author in head/foot}\insertshortdate
      \hspace*{4ex}\insertframenumber{} / \inserttotalframenumber{}
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

%  Headline (navigasi bagian di atas) — emas di atas putih
\setbeamercolor{section in head/foot}{fg=scisGold, bg=white}
\setbeamercolor{title in head/foot}{fg=white, bg=scisGold}
\setbeamercolor{headline}{fg=scisGold, bg=white}

%  ---- ELEMEN LAIN ---------------------------------------------------
\setbeamercolor{item projected}{bg=scisGold}   % lingkaran penomoran
\setbeamercolor{itemize item}{fg=scisGold}     % bullet level-1
\setbeamercolor{itemize subitem}{fg=scisGold}  % bullet level-2
\setbeamercolor{button}{bg=scisGold}           % tombol tautan

%  Slide OUTLINE (daftar isi)
\setbeamercolor{section in toc}{fg=black}
\setbeamercolor{subsection in toc}{fg=black}

%  ---- BLOK (block / alertblock / exampleblock) ----------------------
%  Pemakaian: \begin{block}{Judul blok} isi \end{block}
\setbeamercolor{block title}{bg=scisGold, fg=white}          % blok biasa
\setbeamercolor{block body}{bg=scisGold!20}
\setbeamercolor{block title alerted}{bg=orange, fg=white}    % blok peringatan
\setbeamercolor{block body alerted}{bg=orange!10}
\setbeamercolor{block title example}{bg=smuBlue, fg=white}   % blok contoh
\setbeamercolor{block body example}{bg=smuBlue!10}

