%=====================================================================
%  [6] TEMA LUAR & TAMPILAN ATAS
%=====================================================================
%  Outer theme menentukan kerangka: header, footer, sidebar.
\useoutertheme{miniframes}      % navigasi "bola-bola" bagian di atas
% \useoutertheme{default} \useoutertheme{infolines} \useoutertheme{smoothbars}
% \useoutertheme{sidebar}  \useoutertheme{split}     \useoutertheme{shadow}

%  Tinggi batang navigasi atas; sesuaikan 7.0ex jika judul bagian panjang
\setbeamertemplate{headline}{%
    \nointerlineskip
    \begin{beamercolorbox}[wd=\paperwidth,ht=7.0ex]{headline}
        \insertnavigation{\paperwidth}\vspace*{2.0ex}
    \end{beamercolorbox}%
}

%  Hilangkan simbol navigasi di pojok kanan bawah
\setbeamertemplate{navigation symbols}{}

%=====================================================================
%  [7] DAFTAR KODE (LISTINGS)
%=====================================================================
%  Pemakaian (lihat contoh lengkap di 00-contoh-fitur.tex):
%    \begin{lstlisting}[language=Python]
%    def halo(): print("Halo kuantum!")
%    \end{lstlisting}
\lstset{
    basicstyle=\ttfamily\small,                 % font dasar kode
    keywordstyle=\bfseries\color{blue},         % kata kunci  : biru tebal
    emphstyle=\ttfamily\color{red},             % penekanan   : merah
    stringstyle=\color{green!60!black},         % string      : hijau
    numbers=left,                               % nomor baris di kiri
    numberstyle=\small\color{gray},             % gaya nomor baris
    rulesepcolor=\color{red!20!green!20!blue!20},% warna bayangan bingkai
    frame=shadowbox,                            % bingkai bayangan
    xleftmargin=0.6cm, xrightmargin=0.4cm,      % margin kiri/kanan kode
}

%=====================================================================
%  [8] MAKRO BANTU NOTASI MATEMATIKA / KUANTUM
%=====================================================================
%  Tujuan: penulisan notasi KONSISTEN dan CEPAT. Contoh:
%    $\ket{\psi}$, $\bra{0}$, $\ketbra{0}{1}$, $\braket{a|b}$,
%    $\Tr(\rho)$, $\rho \in \mathbb{C}^{2\times2}$
\newcommand{\Tr}{\operatorname{Tr}}              % jejak matriks (trace)
\newcommand{\ketbra}[2]{\ket{#1}\bra{#2}}        % proyektor |a><b|
\newcommand{\ev}[1]{\left\langle #1 \right\rangle}% nilai ekspektasi <A>
\newcommand{\Iden}{\mathbb{1}}                   % matriks identitas kuantum

%  Pengganti \text{...} saat mode matematika (lebih aman di caption)
\newcommand{\mr}[1]{\mathrm{#1}}

%  Menulis NAMA PERINTAH/kode di dalam teks biasa — aman dipakai di
%  mana saja (sel tabel, judul blok, caption, item), tidak seperti
%  \verb. Contoh: \code{\frac{a}{b}} atau \code{printf("hi")}
\newcommand{\code}[1]{\texttt{\detokenize{#1}}}

%=====================================================================
%  [9] PENGATURAN EKSTRA
%=====================================================================
%  Bersihkan peringatan \translate dari beamer (lihat
%  https://github.com/josephwright/beamer/issues/449)
\pdfstringdefDisableCommands{\def\translate#1{#1}}

