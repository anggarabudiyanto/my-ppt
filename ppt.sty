%=====================================================================
%  [2] KAP GAMBAR & CAPTION
%=====================================================================
%  Caption berformat:  Gambar <slide>.<urutan>  /  Tabel <slide>.<urutan>
%  Kap gambar: "Gambar <slide>.<urutan>."  |  kap tabel: "Tabel <slide>.<urutan>."
%  Diatur EKSPLISIT per tipe (lebih tangguh daripada mendeteksi tipe).
\renewcommand{\thefigure}{\arabic{framenumber}.\arabic{figure}}% nomor: <slide>.<urutan>
\renewcommand{\thetable}{\arabic{framenumber}.\arabic{table}}
\DeclareCaptionLabelFormat{cap-gambar}{Gambar~#2.\hspace{0.1em}}
\DeclareCaptionLabelFormat{cap-tabel}{Tabel~#2.\hspace{0.1em}}
\DeclareCaptionLabelSeparator{separatorbaru}{ }
\captionsetup{labelsep=separatorbaru}
\captionsetup[figure]{labelformat=cap-gambar}
\captionsetup[table]{labelformat=cap-tabel}

