%=====================================================================
%  [3] KUTIPAN & FOOTNOTE (BIBLATEX)
%=====================================================================
%  * Basis data pustaka : bib.bib  (entri BibTeX — lihat contoh di sana)
%  * Gaya               : numeric (angka), urutan sesuai kemunculan
%  * Backend            : bibtex (standar di semua instalasi TeX;
%                         ganti ke backend=biber jika ingin fitur penuh
%                         dan jalankan `biber main` sebagai ganti `bibtex main`)
\usepackage[style=numeric, sorting=none, backend=bibtex]{biblatex}
\addbibresource{bib.bib}          % <-- daftar file .bib (tambahkan bila perlu)
\setbeamerfont{footnote}{size=\tiny}   % ukuran teks footnote

%  Perintah kutipan yang tersedia:
%    \cite{kunci}        -> [3]                       (nomor biasa)
%    \firstcite{kunci}   -> footnote lengkap pertama kali
%                           (penulis, judul, tahun di kaki slide)
%    \secondcite{kunci}  -> footnote penanda saja (setelah pertama)
\DeclareCiteCommand{\firstcite}
  {\usebibmacro{prenote}}
  {% penanda superscript di teks + catatan kaki berisi detail pustaka
    \footnotemark[\thefield{labelnumber}]%
    \footnotetext[\thefield{labelnumber}]{%
        \printnames{labelname}%                              nama penulis
        \setunit{\printdelim{nametitledelim}}%               pemisah
        \printfield[citetitle]{labeltitle}%                  judul
        \setunit{\printdelim{nametitledelim}}%               pemisah
        \printfield{year}%                                   tahun
        \newunit{\adddot}}%                                  titik penutup
  }
  {\multicitedelim}
  {\usebibmacro{postnote}}

\DeclareCiteCommand{\secondcite}
  {\usebibmacro{prenote}}
  {\footnotemark[\thefield{labelnumber}]}% hanya penanda nomor
  {\multicitedelim}
  {\usebibmacro{postnote}}

%  Judul slide daftar pustaka dalam bahasa Indonesia ("Referensi").
